{
  "name": "signpost",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "A static site that shows what every platform team is working on, which stage each effort is in, and what is about to change.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "sync": "astro sync",
    "validate": "tsx scripts/validate-content.ts",
    "schema": "tsx scripts/json-schema.ts",
    "announce": "tsx scripts/announce.ts",
    "release-notes": "tsx scripts/changelog.ts",
    "release": "tsx scripts/release.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.1",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.3.3",
    "github-slugger": "^2.0.0",
    "marked": "^18.0.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.1",
    "@xmldom/xmldom": "^0.9.12",
    "js-yaml": "^5.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
