# Refuse to install or run on a Node older than package.json's `engines` field.
#
# .nvmrc pins Node 24, but it only takes effect for people who run `nvm use`
# (and for CI, via node-version-file). Without this, someone on an older
# default Node gets a stack trace from Astro or a vitest startup crash instead
# of being told their Node is too old.
engine-strict=true
