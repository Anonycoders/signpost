---
import Container from './Container.astro';

/** Standard title block at the top of a section page. */
interface Props {
  title: string;
  /** One sentence telling the reader what this page answers for them. */
  lede?: string;
  width?: 'narrow' | 'default' | 'wide';
}

const { title, lede, width = 'default' } = Astro.props;
---

<div class="border-b border-border bg-surface">
  <Container width={width}>
    <div class="py-10 sm:py-12">
      <h1 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">{title}</h1>
      {lede && <p class="mt-2.5 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-secondary">{lede}</p>}
      <slot />
    </div>
  </Container>
</div>
