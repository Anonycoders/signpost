---
/**
 * Light/dark toggle.
 *
 * The initial theme is applied by an inline script in BaseLayout before first
 * paint, so there is no flash. This component only handles the click.
 * Until the visitor chooses, the site follows their system preference; once
 * they choose, the choice is remembered in localStorage.
 */
---

<button
  type="button"
  id="theme-toggle"
  class="inline-flex size-9 items-center justify-center rounded-badge border border-border text-ink-secondary transition-colors hover:bg-surface-muted hover:text-ink"
  aria-label="Switch to dark theme"
  title="Switch theme"
>
  <svg
    class="size-4 dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
  <svg
    class="hidden size-4 dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
</button>

<script>
  const STORAGE_KEY = 'signpost-theme';
  const button = document.getElementById('theme-toggle');

  function syncLabel(theme: string) {
    const next = theme === 'dark' ? 'light' : 'dark';
    button?.setAttribute('aria-label', `Switch to ${next} theme`);
  }

  syncLabel(document.documentElement.dataset.theme ?? 'light');

  button?.addEventListener('click', () => {
    const current = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    const next = current === 'dark' ? 'light' : 'dark';

    document.documentElement.dataset.theme = next;
    syncLabel(next);

    try {
      localStorage.setItem(STORAGE_KEY, next);
    } catch {
      // Private browsing or blocked storage: the choice simply won't persist.
    }
  });
</script>
