---
import { renderMarkdown } from '@/lib/markdown';

/**
 * Renders a Markdown string held in a YAML field — update bodies and the long
 * body of a streamline.
 *
 * The rendering itself lives in `src/lib/markdown.ts` so the Atom feeds can
 * reuse it; see the notes there about dropped raw HTML.
 */
interface Props {
  content: string;
  class?: string;
}

const { content, class: className = 'prose' } = Astro.props;

const html = renderMarkdown(content);
---

<div class={className} set:html={html} />
