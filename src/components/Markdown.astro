---
import { Marked } from 'marked';

/**
 * Renders a Markdown string from frontmatter — update bodies, mainly.
 *
 * The long-form body of a streamline file goes through Astro's own pipeline
 * instead; this is only for the short prose that lives inside YAML fields.
 *
 * Raw HTML is dropped rather than passed through. Content is reviewed before it
 * merges, so this is not the primary defence, but it costs nothing and means a
 * stray `<script>` in a pull request cannot become a stored XSS on a site the
 * whole company reads.
 */
interface Props {
  content: string;
  class?: string;
}

const { content, class: className = 'prose' } = Astro.props;

const marked = new Marked({
  gfm: true,
  breaks: false,
  renderer: {
    html: () => '',
  },
});

const html = await marked.parse(content);
---

<div class={className} set:html={html} />
