---
/**
 * The contents of one guide, built from the headings the Markdown already has.
 *
 * Two of the guides also write a "Contents" list into their own text, because a
 * reader on GitHub has no other way to see the shape of a long file. On the
 * site that list is hidden (`global.css`) and this stands in its place: same
 * links, but it stays on screen while you read and it marks where you are.
 */

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  /** `rail` is the sticky column; `inline` is the collapsed one on a phone. */
  variant: 'rail' | 'inline';
}

const { headings, variant } = Astro.props;
---

{
  headings.length > 0 &&
    (variant === 'rail' ? (
      <nav class="doc-toc sticky top-20 max-h-[calc(100vh-7rem)] overflow-y-auto" aria-label="On this page">
        <p class="text-xs font-medium uppercase tracking-wide text-ink-muted">On this page</p>
        <ul class="mt-3 space-y-1.5 border-l border-border">
          {headings.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                data-toc-link={heading.slug}
                class:list={[
                  'block border-l -ml-px py-0.5 text-[0.8125rem] leading-snug text-ink-muted transition-colors hover:text-ink',
                  heading.depth > 2 ? 'border-transparent pl-6' : 'border-transparent pl-3',
                ]}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ) : (
      <details class="rounded-card border border-border bg-surface-muted px-4 py-3">
        <summary class="cursor-pointer text-sm font-medium text-ink marker:text-ink-muted">
          On this page
        </summary>
        <ul class="mt-3 space-y-1.5">
          {headings.map((heading) => (
            <li class:list={[heading.depth > 2 && 'pl-4']}>
              <a href={`#${heading.slug}`} class="text-sm text-accent hover:text-accent-hover">
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))
}
