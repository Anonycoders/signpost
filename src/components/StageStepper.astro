---
import type { Streamline } from '@/lib/content';
import { formatDate, isFuture, isoDate, relativeDays } from '@/lib/date';
import { toneSolidVar } from '@/lib/tone';

/**
 * The lifecycle of one streamline as a stepper.
 *
 * Only stages with a date are shown — that is the story this streamline
 * actually has, rather than a row of stages it skipped. Dates in the future are
 * drawn as plans (hollow marker, dashed connector) so a reader is never left
 * guessing which parts have happened. The stage it is sitting in right now
 * pulses, so that "where is this today" is answered before the page is read.
 */
interface Props {
  streamline: Streamline;
}

const { streamline } = Astro.props;

const steps = streamline.timeline.map((entry) => {
  const current = entry.stage.id === streamline.stage.id;

  return {
    ...entry,
    planned: isFuture(entry.date),
    current,
    /**
     * Whether this step gets the pulse.
     *
     * The stage a streamline is sitting in right now, unless that stage is a
     * terminal one — a switched-off thing is still "current" somewhere on the
     * stepper, and a heartbeat on it would say the opposite of what the grey
     * callout above the stepper says. Asked of the lifecycle rather than of a
     * stage name, so a fork that renames its stages keeps the behaviour.
     */
    beating: current && !entry.stage.terminal,
  };
});
---

<ol class="stepper" aria-label="Lifecycle">
  {
    steps.map((step, index) => (
      <li
        class:list={[
          'step',
          { planned: step.planned, current: step.current, beating: step.beating },
        ]}
        style={`--dot: ${toneSolidVar[step.stage.tone]}`}
      >
        {/*
          The connector belongs to the step above the run it draws, so it can be
          anchored to both ends of the gap rather than given a fixed length —
          the gap grows whenever a label wraps. It is dashed when the stage it
          leads to has not happened yet.
        */}
        {index < steps.length - 1 && (
          <span
            class:list={['connector', { 'to-planned': steps[index + 1].planned }]}
            aria-hidden="true"
          />
        )}
        <span class="marker" aria-hidden="true" />
        <div class="label">
          <span class="name">
            {step.stage.label}
            {step.current && <span class="sr-only"> (current stage)</span>}
          </span>
          <time datetime={isoDate(step.date)} class="date">
            {formatDate(step.date)}
          </time>
          <span class="relative-date">
            {step.planned ? `planned, ${relativeDays(step.date)}` : relativeDays(step.date)}
          </span>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .stepper {
    display: flex;
    flex-direction: column;
    gap: 0;

    /* One geometry for the dots and the lines between them, so a connector
     * cannot drift away from a marker when one of them is adjusted. */
    --dot-size: 0.75rem;
    /* What the marker is nudged down by in the vertical layout, to sit on the
     * first line of its label. */
    --dot-offset: 0.3125rem;
    /* Clearance between a dot and the line either side of it. Matches the ring
     * around the current stage, so the line stops at the ring rather than
     * running through it. */
    --dot-gap: 0.25rem;
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: 0 0.75rem;
    padding-bottom: 1.25rem;
  }

  .step:last-child {
    padding-bottom: 0;
  }

  /* Vertical run from this step's marker down to the next step's marker.
   * Anchored at both ends: `bottom` is measured from this step's bottom edge,
   * which is where the next marker begins, so a label that wraps to three lines
   * stretches the line with it. */
  .connector {
    position: absolute;
    left: 0.5625rem;
    top: calc(var(--dot-offset) + var(--dot-size) + var(--dot-gap));
    bottom: calc(var(--dot-gap) - var(--dot-offset));
    border-left: 2px solid var(--color-border-strong);
  }

  .connector.to-planned {
    border-left-style: dashed;
  }

  /* `block` matters: in the horizontal layout below the step is a block box,
   * and an inline span would ignore width and height entirely. `relative` is
   * for the pulse, which is drawn as a ring around this dot. */
  .marker {
    position: relative;
    display: block;
    margin-top: 0.3125rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 9999px;
    background: var(--dot);
    justify-self: center;
  }

  /* A planned stage is drawn hollow: it has not happened yet. */
  .step.planned .marker {
    background: var(--color-surface);
    border: 2px solid var(--dot);
  }

  .step.current .marker {
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--dot) 22%, transparent);
  }

  /* The pulse: a second ring, starting exactly where the resting ring above
   * sits, expanding out of it and fading. A ring rather than a filled disc so
   * it reads the same around a hollow planned marker as around a solid one,
   * and so it never covers the dot it is drawing attention to.
   *
   * It rests at `opacity: 0`, which is what makes the reduced-motion rule in
   * global.css do the right thing for free: that rule cuts the animation to a
   * single 0.01ms run, after which the element falls back to these base styles
   * and disappears, leaving the static ring alone to mark the current stage —
   * exactly the page as it was before this existed.
   *
   * Animating transform and opacity only, rather than the spread of the ring
   * itself, so the browser can hand the whole thing to the compositor instead
   * of repainting a box-shadow for as long as the page is open.
   */
  .step.beating .marker::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--dot) 45%, transparent);
    opacity: 0;
    animation: stage-beat 2.4s ease-out infinite;
  }

  /* Long and slow on purpose. This sits beside prose that people are reading,
   * and a fast pulse stops being a signal and becomes something to scroll away
   * from. The rest at the end is most of the cycle: one beat, then quiet. */
  @keyframes stage-beat {
    0% {
      opacity: 0.8;
      transform: scale(1);
    }

    70% {
      opacity: 0;
      transform: scale(2);
    }

    100% {
      opacity: 0;
      transform: scale(2);
    }
  }

  .label {
    display: flex;
    flex-direction: column;
    gap: 0.0625rem;
    min-width: 0;
  }

  .name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .step.planned .name {
    color: var(--color-ink-secondary);
    font-weight: 500;
  }

  .date {
    font-size: 0.8125rem;
    color: var(--color-ink-secondary);
  }

  .relative-date {
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }

  @media (min-width: 768px) {
    .stepper {
      flex-direction: row;
    }

    .step {
      flex: 1;
      display: block;
      padding-bottom: 0;
      padding-right: 1rem;
    }

    /* Horizontal run, from this step's marker across to the next one. The step
     * box ends exactly where the next marker starts, so anchoring `right` to it
     * gives both ends the same clearance. `top` centres the 2px line on the
     * 12px dot rather than leaving it a pixel low. */
    .connector {
      top: calc(var(--dot-size) / 2 - 1px);
      bottom: auto;
      left: calc(var(--dot-size) + var(--dot-gap));
      right: var(--dot-gap);
      border-left: none;
      border-top: 2px solid var(--color-border-strong);
    }

    .connector.to-planned {
      border-top-style: dashed;
    }

    .marker {
      margin-top: 0;
      justify-self: start;
    }

    .label {
      margin-top: 0.625rem;
    }
  }
</style>
