---
import { updateAnchor } from '@/lib/anchor';
import type { Update } from '@/lib/content';
import { formatDate, isoDate, relativeDays } from '@/lib/date';
import { toneSolidVar } from '@/lib/tone';
import Badge from './Badge.astro';
import Markdown from './Markdown.astro';
import UpdateActions from './UpdateActions.astro';

interface Props {
  update: Update;
  /** Show which streamline this came from — needed on cross-streamline feeds. */
  showStreamline?: boolean;
  /** Off on a page already scoped to one team, where the name only repeats. */
  showTeam?: boolean;
  /**
   * Give this update a fragment id, so the Atom feed can link straight to it.
   * Set only on the streamline page: the same update also appears on its team
   * page, and two elements with one id is a broken document.
   */
  anchor?: boolean;
}

const { update, showStreamline = false, showTeam = true, anchor = false } = Astro.props;

const id = anchor ? updateAnchor(update) : undefined;
---

<article class="relative scroll-mt-24 pl-6" id={id}>
  <span
    class="absolute left-0 top-[0.4375rem] size-2 rounded-full"
    style={`background: ${toneSolidVar[update.impact.tone]}`}
    aria-hidden="true"
  ></span>

  <div class="flex flex-wrap items-center gap-x-2 gap-y-1.5">
    <Badge tone={update.impact.tone} title={update.impact.description}>
      {update.impact.label}
    </Badge>
    <time datetime={isoDate(update.date)} class="text-xs text-ink-muted">
      {formatDate(update.date)} · {relativeDays(update.date)}
    </time>
    {
      /* The day it lands, when that is not the day it was written — the thing a
         reader has to put in their calendar. */
      update.effective && (
        <span class="text-xs font-medium text-ink-secondary">
          takes effect{' '}
          <time datetime={isoDate(update.effective)}>{formatDate(update.effective)}</time>
        </span>
      )
    }
  </div>

  {
    showStreamline && (
      <p class="mt-2 text-xs text-ink-muted">
        <a href={update.streamline.href} class="font-medium text-ink-secondary hover:text-accent">
          {update.streamline.title}
        </a>
        {showTeam && <span> · {update.streamline.team.name}</span>}
      </p>
    )
  }

  <h3 class="mt-2 text-[0.9375rem] font-semibold leading-snug text-ink">
    {update.title}
  </h3>

  {update.body && <Markdown class="prose mt-2 text-sm" content={update.body} />}

  {update.actions && update.actions.length > 0 && (
    <UpdateActions actions={update.actions} tone={update.impact.tone} class="mt-3" />
  )}
</article>
