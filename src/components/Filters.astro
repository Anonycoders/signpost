---
import { siteConfig } from '@config';
import type { Team } from '@/lib/content';

/**
 * Team / category / stage filters, shared by the catalog and the roadmap.
 *
 * Every row is rendered server-side and filtering happens in the page, so
 * results are instant and the site still works with JavaScript disabled — the
 * filters simply do nothing and everything stays visible.
 *
 * The current selection is mirrored into the query string so a filtered view
 * can be pasted into a chat message and open the same way for someone else.
 *
 * It filters any element carrying `data-streamline` plus the `data-team`,
 * `data-category`, `data-status` and `data-search` attributes, which is why
 * the roadmap's lanes and the catalog's cards can share one implementation.
 * Containers marked `data-group` hide themselves when nothing inside them
 * survives, so the roadmap does not leave behind empty team headings.
 *
 * With nothing to filter, the whole control renders nothing. A fresh fork has
 * no streamlines, and a search box over zero results, three selects that cannot
 * change anything and the line "Showing all 0 streamlines" are a worse first
 * impression than the page simply saying what to add. The page's own empty
 * state says that, so this stays out of its way.
 */
interface Props {
  teams: Team[];
  total: number;
  /** Off on the roadmap, where a lane is a bar rather than readable text. */
  showSearch?: boolean;
}

const { teams, total, showSearch = true } = Astro.props;

const selects = [
  {
    id: 'filter-team',
    param: 'team',
    label: 'Team',
    options: teams.map((team) => ({ value: team.slug, label: team.name })),
  },
  {
    id: 'filter-category',
    param: 'category',
    label: 'Category',
    options: siteConfig.categories.map((category) => ({
      value: category.id,
      label: category.label,
    })),
  },
  {
    id: 'filter-status',
    param: 'status',
    label: 'Stage',
    options: siteConfig.lifecycle.map((stage) => ({ value: stage.id, label: stage.label })),
  },
];
---

{
  total > 0 && (
    <Fragment>
      <form
        id="filters"
        class="flex flex-col gap-4 rounded-card border border-border bg-surface p-4 sm:flex-row sm:items-end"
        role="search"
        aria-label="Filter streamlines"
        onsubmit="return false"
      >
        {showSearch && (
          <div class="flex-1">
            <label for="filter-search" class="mb-1.5 block text-xs font-medium text-ink-secondary">
              Search
            </label>
            <input
              type="search"
              id="filter-search"
              name="q"
              placeholder="Title, summary, owner…"
              autocomplete="off"
              class="w-full rounded-badge border border-border bg-canvas px-3 py-2 text-sm text-ink placeholder:text-ink-muted focus:border-accent focus:outline-none"
            />
          </div>
        )}

        {!showSearch && <div class="flex-1" />}

        {selects.map((select) => (
          <div class="sm:w-44">
            <label for={select.id} class="mb-1.5 block text-xs font-medium text-ink-secondary">
              {select.label}
            </label>
            <select
              id={select.id}
              name={select.param}
              class="w-full rounded-badge border border-border bg-canvas px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none"
            >
              <option value="">All</option>
              {select.options.map((option) => (
                <option value={option.value}>{option.label}</option>
              ))}
            </select>
          </div>
        ))}

        <button
          type="button"
          id="filter-reset"
          class="hidden rounded-badge border border-border px-3 py-2 text-sm font-medium text-ink-secondary transition-colors hover:bg-surface-muted hover:text-ink"
        >
          Clear
        </button>
      </form>

      <p class="mt-4 text-sm text-ink-secondary" id="filter-count" aria-live="polite">
        Showing all {total} streamline{total === 1 ? '' : 's'}
      </p>
    </Fragment>
  )
}

<script>
  const form = document.getElementById('filters') as HTMLFormElement | null;
  const search = document.getElementById('filter-search') as HTMLInputElement | null;
  const reset = document.getElementById('filter-reset');
  const count = document.getElementById('filter-count');
  const empty = document.getElementById('filter-empty');
  // Chrome around the results — a grid card, a quarter header — that should go
  // away with them rather than sit there as an empty box.
  const chrome = Array.from(document.querySelectorAll<HTMLElement>('[data-hide-when-empty]'));
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-streamline]'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'));

  if (form && count) {
    const selects = Array.from(form.querySelectorAll<HTMLSelectElement>('select'));
    const total = rows.length;

    /** Restore a shared link's filters before the first paint of results. */
    function readUrl() {
      const params = new URLSearchParams(window.location.search);
      if (search) search.value = params.get('q') ?? '';
      for (const select of selects) {
        const value = params.get(select.name);
        if (value && select.querySelector(`option[value="${CSS.escape(value)}"]`)) {
          select.value = value;
        }
      }
    }

    function writeUrl() {
      const params = new URLSearchParams();
      const query = search?.value.trim() ?? '';
      if (query) params.set('q', query);
      for (const select of selects) {
        if (select.value) params.set(select.name, select.value);
      }

      const search_ = params.toString();
      window.history.replaceState(
        {},
        '',
        search_ ? `${window.location.pathname}?${search_}` : window.location.pathname,
      );
    }

    function apply() {
      const query = search?.value.trim().toLowerCase() ?? '';
      const active = Object.fromEntries(
        selects.filter((select) => select.value).map((select) => [select.name, select.value]),
      );
      const hasFilters = query.length > 0 || Object.keys(active).length > 0;

      let visible = 0;

      for (const row of rows) {
        const matches =
          Object.entries(active).every(([key, value]) => row.dataset[key] === value) &&
          (query === '' || (row.dataset['search'] ?? '').includes(query));

        row.hidden = !matches;
        if (matches) visible += 1;
      }

      // A group heading with nothing under it is worse than no heading.
      for (const group of groups) {
        const survivors = group.querySelectorAll('[data-streamline]:not([hidden])').length;
        group.hidden = survivors === 0;
      }

      count!.textContent = hasFilters
        ? `Showing ${visible} of ${total} streamline${total === 1 ? '' : 's'}`
        : `Showing all ${total} streamline${total === 1 ? '' : 's'}`;

      reset?.classList.toggle('hidden', !hasFilters);
      empty?.classList.toggle('hidden', visible > 0);
      for (const element of chrome) element.hidden = visible === 0;

      writeUrl();
    }

    readUrl();
    apply();

    search?.addEventListener('input', apply);
    for (const select of selects) select.addEventListener('change', apply);

    reset?.addEventListener('click', () => {
      if (search) search.value = '';
      for (const select of selects) select.value = '';
      apply();
    });
  }
</script>
