---
import { siteConfig } from '@config';
import type { Team } from '@/lib/content';

/**
 * Filters for the streamline catalog.
 *
 * Every card is rendered server-side and filtering happens in the page, so
 * results are instant and the site still works with JavaScript disabled — the
 * filters simply do nothing and every streamline stays visible.
 *
 * The current selection is mirrored into the query string so a filtered view
 * can be pasted into a chat message and open the same way for someone else.
 */
interface Props {
  teams: Team[];
  total: number;
}

const { teams, total } = Astro.props;

const selects = [
  {
    id: 'filter-team',
    param: 'team',
    label: 'Team',
    options: teams.map((team) => ({ value: team.slug, label: team.name })),
  },
  {
    id: 'filter-category',
    param: 'category',
    label: 'Category',
    options: siteConfig.categories.map((category) => ({
      value: category.id,
      label: category.label,
    })),
  },
  {
    id: 'filter-status',
    param: 'status',
    label: 'Stage',
    options: siteConfig.lifecycle.map((stage) => ({ value: stage.id, label: stage.label })),
  },
];
---

<form
  id="catalog-filters"
  class="flex flex-col gap-4 rounded-card border border-border bg-surface p-4 sm:flex-row sm:items-end"
  role="search"
  aria-label="Filter streamlines"
  onsubmit="return false"
>
  <div class="flex-1">
    <label for="filter-search" class="mb-1.5 block text-xs font-medium text-ink-secondary">
      Search
    </label>
    <input
      type="search"
      id="filter-search"
      name="q"
      placeholder="Title, summary, owner…"
      autocomplete="off"
      class="w-full rounded-badge border border-border bg-canvas px-3 py-2 text-sm text-ink placeholder:text-ink-muted focus:border-accent focus:outline-none"
    />
  </div>

  {
    selects.map((select) => (
      <div class="sm:w-44">
        <label
          for={select.id}
          class="mb-1.5 block text-xs font-medium text-ink-secondary"
        >
          {select.label}
        </label>
        <select
          id={select.id}
          name={select.param}
          class="w-full rounded-badge border border-border bg-canvas px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none"
        >
          <option value="">All</option>
          {select.options.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))}
        </select>
      </div>
    ))
  }

  <button
    type="button"
    id="filter-reset"
    class="hidden rounded-badge border border-border px-3 py-2 text-sm font-medium text-ink-secondary transition-colors hover:bg-surface-muted hover:text-ink"
  >
    Clear
  </button>
</form>

<p class="mt-4 text-sm text-ink-secondary" id="catalog-count" aria-live="polite">
  Showing all {total} streamlines
</p>

<script>
  const form = document.getElementById('catalog-filters') as HTMLFormElement | null;
  const search = document.getElementById('filter-search') as HTMLInputElement | null;
  const reset = document.getElementById('filter-reset');
  const count = document.getElementById('catalog-count');
  const empty = document.getElementById('catalog-empty');
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('[data-streamline]'),
  );

  if (form && search && count) {
    const selects = Array.from(form.querySelectorAll<HTMLSelectElement>('select'));
    const total = cards.length;

    /** Restore a shared link's filters before the first paint of results. */
    function readUrl() {
      const params = new URLSearchParams(window.location.search);
      search!.value = params.get('q') ?? '';
      for (const select of selects) {
        const value = params.get(select.name);
        if (value && select.querySelector(`option[value="${CSS.escape(value)}"]`)) {
          select.value = value;
        }
      }
    }

    function writeUrl() {
      const params = new URLSearchParams();
      if (search!.value.trim()) params.set('q', search!.value.trim());
      for (const select of selects) {
        if (select.value) params.set(select.name, select.value);
      }

      const query = params.toString();
      window.history.replaceState(
        {},
        '',
        query ? `${window.location.pathname}?${query}` : window.location.pathname,
      );
    }

    function apply() {
      const query = search!.value.trim().toLowerCase();
      const active = Object.fromEntries(
        selects.filter((select) => select.value).map((select) => [select.name, select.value]),
      );
      const hasFilters = query.length > 0 || Object.keys(active).length > 0;

      let visible = 0;

      for (const card of cards) {
        const matches =
          Object.entries(active).every(([key, value]) => card.dataset[key] === value) &&
          (query === '' || (card.dataset['search'] ?? '').includes(query));

        card.hidden = !matches;
        if (matches) visible += 1;
      }

      count!.textContent = hasFilters
        ? `Showing ${visible} of ${total} streamline${total === 1 ? '' : 's'}`
        : `Showing all ${total} streamline${total === 1 ? '' : 's'}`;

      reset?.classList.toggle('hidden', !hasFilters);
      empty?.classList.toggle('hidden', visible > 0);

      writeUrl();
    }

    readUrl();
    apply();

    search.addEventListener('input', apply);
    for (const select of selects) select.addEventListener('change', apply);

    reset?.addEventListener('click', () => {
      search!.value = '';
      for (const select of selects) select.value = '';
      apply();
    });
  }
</script>
