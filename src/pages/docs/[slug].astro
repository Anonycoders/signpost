---
import { render } from 'astro:content';

import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { getDocs, type Doc } from '@/lib/content';
import { url } from '@/lib/url';

/**
 * One of the guides, rendered as a page.
 *
 * These files are read in two places — here and on GitHub — and there is only
 * one copy of each. So the page adds as little as it can around the document:
 * no page header duplicating a title the Markdown already carries, and no
 * restructuring. What it does add is the way back out: the other guides, and
 * the file itself for anyone who would rather read or edit it in the
 * repository.
 */

export async function getStaticPaths() {
  const docs = await getDocs();
  return docs.map((doc) => ({
    params: { slug: doc.slug },
    props: { doc, others: docs.filter((other) => other.slug !== doc.slug) },
  }));
}

interface Props {
  doc: Doc;
  others: Doc[];
}

const { doc, others } = Astro.props;
const { Content } = await render(doc.entry);
---

<BaseLayout title={doc.title} description={doc.summary}>
  <Container width="narrow">
    <div class="py-10 pb-16">
      <p class="text-xs text-ink-muted">
        <a href={url('/docs')} class="hover:text-ink-secondary">Guides</a>
      </p>

      <article class="prose mt-4">
        <Content />
      </article>

      <footer class="mt-12 border-t border-border pt-6">
        {
          others.length > 0 && (
            <>
              <h2 class="text-xs font-medium uppercase tracking-wide text-ink-muted">
                Other guides
              </h2>
              <ul class="mt-3 space-y-2">
                {others.map((other) => (
                  <li class="text-sm">
                    <a href={other.href} class="font-medium text-accent hover:text-accent-hover">
                      {other.title}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )
        }

        <p class="mt-6 text-xs text-ink-muted">
          <a href={doc.editUrl} class="hover:text-ink-secondary">Read this page's source on GitHub</a>
        </p>
      </footer>
    </div>
  </Container>
</BaseLayout>
