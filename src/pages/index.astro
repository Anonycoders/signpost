---
import { siteConfig } from '@config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import ChangeRow from '@/components/ChangeRow.astro';
import EmptyState from '@/components/EmptyState.astro';
import UpdateEntry from '@/components/UpdateEntry.astro';
import { needsAttention } from '@/lib/changes';
import { getAllUpdates, getStreamlines, getTeams } from '@/lib/content';
import { formatDate, isoDate, today } from '@/lib/date';
import { url } from '@/lib/url';

/**
 * The home page answers one question before any other: is there anything here
 * that is about to break my week?
 *
 * So the attention strip comes before the tour of the site. Someone who opens
 * this page every Monday should be able to close it again in ten seconds when
 * the answer is no.
 */

const [streamlines, teams, allUpdates] = await Promise.all([
  getStreamlines(),
  getTeams(),
  getAllUpdates(),
]);

const now = today();

const attention = needsAttention(
  streamlines,
  now,
  siteConfig.attentionWindowDays,
  siteConfig.attentionWeight,
  siteConfig.recentWindowDays,
);

/** A fresh fork has no content yet, and needs telling what to do next. */
const hasContent = streamlines.length > 0;

const LATEST_UPDATE_COUNT = 5;
const latest = allUpdates.slice(0, LATEST_UPDATE_COUNT);
const lastPosted = allUpdates[0]?.date;

const active = streamlines.filter((streamline) => !streamline.isTerminal);

/**
 * Things still running that already have a date for switching off — the work
 * other teams have to schedule, which is why it earns a number on the front
 * page rather than a place further down.
 *
 * Read from the `terminal` flag rather than a stage named "retired", so an
 * organization that renames its lifecycle keeps a working home page.
 */
const endingStage = [...siteConfig.lifecycle].reverse().find((stage) => stage.terminal === true);

const ending = streamlines.filter(
  (streamline) =>
    !streamline.isTerminal &&
    streamline.timeline.some((entry) => entry.stage.terminal === true && entry.date > now),
);

const stats = [
  { value: teams.length, label: teams.length === 1 ? 'Team' : 'Teams', href: url('/teams') },
  { value: active.length, label: 'Streamlines in flight', href: url('/streamlines') },
  {
    value: ending.length,
    // Terminal stage labels read as participles ("Retired", "Archived"), so
    // this stays grammatical whatever an organization calls the end of its
    // lifecycle.
    label: endingStage ? `Due to be ${endingStage.label.toLowerCase()}` : 'Ending soon',
    href: url('/roadmap'),
  },
];
---

<BaseLayout>
  <Container>
    <section class="pt-14 pb-10 sm:pt-20 sm:pb-12">
      <h1 class="max-w-3xl text-3xl font-semibold tracking-tight text-balance text-ink sm:text-4xl">
        {siteConfig.tagline}
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-secondary">
        {siteConfig.description}
      </p>

      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href={url('/roadmap')}
          class="rounded-badge bg-accent px-4 py-2 text-sm font-medium text-accent-ink transition-colors hover:bg-accent-hover"
        >
          See the roadmap
        </a>
        <a
          href={url('/changes')}
          class="rounded-badge border border-border px-4 py-2 text-sm font-medium text-ink transition-colors hover:bg-surface-muted"
        >
          What's changing soon
        </a>
      </div>

      {
        lastPosted && (
          <p class="mt-6 text-xs text-ink-muted">
            Last update posted{' '}
            <time datetime={isoDate(lastPosted)}>{formatDate(lastPosted)}</time>.{' '}
            <a href={url('/feed.xml')} class="transition-colors hover:text-accent">
              Subscribe to the feed
            </a>{' '}
            and you will not have to come looking.
          </p>
        )
      }
    </section>

    {
      /*
       * A fresh fork lands here first, before anyone has written a file.
       * Telling the person who just cloned it what to do next is more useful
       * than three sections of zeroes.
       */
      !hasContent && (
        <section class="border-t border-border py-10 pb-16">
          <EmptyState
            title="Nothing has been published yet."
            description="Add a team file under content/teams/ and a streamline under content/streamlines/, open a pull request, and this page fills itself in."
          >
            <a
              href={url('/about')}
              class="mt-4 inline-block text-sm font-medium text-accent transition-colors hover:text-accent-hover"
            >
              How to add your team
            </a>
          </EmptyState>
        </section>
      )
    }

    {
      hasContent && (
        <section class="border-t border-border py-10" aria-labelledby="attention-heading">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h2 id="attention-heading" class="text-base font-semibold text-ink">
              Needs your attention
            </h2>
            {/*
              The strip is bounded at both ends, and saying only "landing
              within 60 days" leaves a reader wondering why something that
              already happened is sitting at the top of the page.
            */}
            <p class="text-xs text-ink-muted">
              Landing within {siteConfig.attentionWindowDays} days, or landed in the last{' '}
              {siteConfig.recentWindowDays}
            </p>
          </div>

          {attention.length === 0 ? (
            <div class="mt-4">
              <EmptyState
                title="Nothing is about to break."
                description={`No team has posted a change of consequence that landed in the last ${siteConfig.recentWindowDays} days or is due in the next ${siteConfig.attentionWindowDays}.`}
              >
                <a
                  href={url('/changes')}
                  class="mt-4 inline-block text-sm font-medium text-accent transition-colors hover:text-accent-hover"
                >
                  See everything that is scheduled
                </a>
              </EmptyState>
            </div>
          ) : (
            <>
              <ol class="mt-4 space-y-3">
                {attention.map((item) => (
                  <ChangeRow item={item} level={3} />
                ))}
              </ol>
              <a
                href={url('/changes')}
                class="mt-4 inline-block text-sm font-medium text-accent transition-colors hover:text-accent-hover"
              >
                All upcoming changes
              </a>
            </>
          )}
        </section>
      )
    }

    {
      /*
       * Three zeroes under "nothing has been published yet" tell a fresh fork
       * nothing it does not already know.
       */
      hasContent && (
        <section class="border-t border-border py-10" aria-labelledby="landscape-heading">
          <h2 id="landscape-heading" class="sr-only">
            The platform at a glance
          </h2>

          <dl class="grid gap-4 sm:grid-cols-3">
            {stats.map((stat) => (
              <div class="relative rounded-card border border-border bg-surface p-5 transition-colors hover:border-border-strong">
                <dt class="text-sm text-ink-secondary">
                  <a href={stat.href} class="after:absolute after:inset-0">
                    {stat.label}
                  </a>
                </dt>
                <dd class="mt-1 text-3xl font-semibold tracking-tight tabular-nums text-ink">
                  {stat.value}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      latest.length > 0 && (
        <section class="border-t border-border py-10 pb-16" aria-labelledby="latest-heading">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h2 id="latest-heading" class="text-base font-semibold text-ink">
              Latest from the teams
            </h2>
            <a
              href={url('/changes')}
              class="text-sm font-medium text-accent transition-colors hover:text-accent-hover"
            >
              See all changes
            </a>
          </div>

          <div class="mt-6 max-w-2xl space-y-7">
            {latest.map((update) => (
              <UpdateEntry update={update} showStreamline />
            ))}
          </div>
        </section>
      )
    }
  </Container>
</BaseLayout>
