---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import PageHeader from '@/components/PageHeader.astro';
import EmptyState from '@/components/EmptyState.astro';
---

<BaseLayout title="Teams" description="Who owns what, and where to reach them.">
  <PageHeader
    title="Teams"
    lede="The teams publishing here, what each of them owns, and where to reach them when you have a question."
  />
  <Container>
    <div class="py-10">
      <EmptyState title="Team pages are built in milestone 2." />
    </div>
  </Container>
</BaseLayout>
