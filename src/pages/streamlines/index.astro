---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import PageHeader from '@/components/PageHeader.astro';
import Filters from '@/components/Filters.astro';
import StreamlineCard from '@/components/StreamlineCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import { getStreamlines, getTeams } from '@/lib/content';

const [streamlines, teams] = await Promise.all([getStreamlines(), getTeams()]);

// Active work first; retired things stay on the site but drop to the bottom.
const ordered = [...streamlines].sort((a, b) => {
  if (a.isTerminal !== b.isTerminal) return a.isTerminal ? 1 : -1;
  return a.title.localeCompare(b.title);
});
---

<BaseLayout
  title="Streamlines"
  description="Every product, initiative and migration the platform teams own."
>
  {/*
    The filters are not rendered with nothing to filter, so the sentence that
    points at them goes too — otherwise the page describes a control that is
    not on it.
  */}
  <PageHeader
    title="Streamlines"
    lede={
      ordered.length > 0
        ? 'Every product, initiative and migration the platform teams own. Filter by team, category or stage to find what you need.'
        : 'Every product, initiative and migration the platform teams own.'
    }
  />

  <Container>
    <div class="py-8">
      <Filters teams={teams} total={ordered.length} />

      {
        ordered.length === 0 ? (
          <div class="mt-6">
            <EmptyState
              title="Nothing published yet."
              description="Add a file under content/streamlines/ to put your team's work on this page."
            />
          </div>
        ) : (
          <section aria-labelledby="results-heading">
            {/*
              Not decoration: it gives the cards a heading to sit under (they are
              h3, as they are on team pages) and gives anyone navigating by
              heading a way past the filter form.
            */}
            <h2 id="results-heading" class="sr-only">
              Results
            </h2>

            <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {ordered.map((streamline) => (
                <StreamlineCard streamline={streamline} />
              ))}
            </div>

            <div id="filter-empty" class="mt-6 hidden">
              <EmptyState
                title="No streamlines match those filters."
                description="Try clearing one of them, or searching for something broader."
              />
            </div>
          </section>
        )
      }
    </div>
  </Container>
</BaseLayout>
