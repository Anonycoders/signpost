---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import PageHeader from '@/components/PageHeader.astro';
import EmptyState from '@/components/EmptyState.astro';
---

<BaseLayout
  title="Streamlines"
  description="Every product, initiative and migration the platform teams own."
>
  <PageHeader
    title="Streamlines"
    lede="Every product, initiative and migration the platform teams own. Filter by team, category or lifecycle stage to find what you need."
  />
  <Container>
    <div class="py-10">
      <EmptyState title="The streamline catalog is built in milestone 2." />
    </div>
  </Container>
</BaseLayout>
