---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import PageHeader from '@/components/PageHeader.astro';
import EmptyState from '@/components/EmptyState.astro';
---

<BaseLayout
  title="Roadmap"
  description="Every platform streamline on one timeline, so you can see what lands when."
>
  <PageHeader
    title="Roadmap"
    lede="Every platform streamline on one timeline, grouped by team. Bars show the lifecycle stages each effort moves through; markers show what is still planned."
    width="wide"
  />
  <Container width="wide">
    <div class="py-10">
      <EmptyState title="The roadmap timeline is built in milestone 3." />
    </div>
  </Container>
</BaseLayout>
